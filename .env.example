# ==============================================================================
# Memora 2.0 — Environment Configuration Template
# Copy this file to .env and fill in the required credentials.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Network Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL=postgresql://memora:memora_dev@localhost:5432/memora

# Redis Cache & Background Queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Qdrant Vector Search Engine
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Cryptographic Keys (Auto-generated fallback in development)
# In production, provide 2048-bit RSA PEM keys and a 32-char hex encryption key:
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# LLM & AI Embedding Models
# Recommended: Google Gemini 1.5 Flash API Key for synthesis & multimodal transcription
GOOGLE_API_KEY=
EMBEDDING_MODE=local
VOYAGE_API_KEY=

# Third-Party OAuth Integrations (Optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe Billing & Webhook Secrets (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability & APM (Optional)
SENTRY_DSN=
